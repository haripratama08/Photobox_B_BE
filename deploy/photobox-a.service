[Unit]
Description=Photobox A (API + Flutter frontend)
After=graphical-session.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/Apk/PHOTOBOX_A
ExecStart=%h/Apk/PHOTOBOX_A/start_photobox_linux.sh
Restart=always
RestartSec=3
TimeoutStopSec=15
Environment=DISPLAY=:0
Environment=XDG_SESSION_TYPE=x11
Environment=PHOTOBOX_SOFTWARE_RENDERING=false
Environment=PHOTOBOX_DISPLAY_MODE=1280x800

[Install]
WantedBy=default.target
